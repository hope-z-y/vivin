{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "docs/**",
    "AGENTS.md",
    "README.md",
    "src-tauri/**",
    "pnpm-lock.yaml",
    "node_modules/**",
    "dist/**"
  ]
}
